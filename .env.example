# Neon Postgres Database Connection String (from neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Primary Google SMTP Configuration
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-app-password

# Secondary Fallback Google SMTP Configuration
SMTP_EMAIL_2=your-fallback-email@gmail.com
SMTP_APP_PASSWORD_2=your-fallback-app-password

# Optional Port
PORT=3000
